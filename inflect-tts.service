[Unit]
Description=Inflect TTS server
After=pipewire.service

[Service]
Type=simple
WorkingDirectory=/absolute/path/to/inflect-speechd
ExecStart=/absolute/path/to/inflect-speechd/.venv/bin/python server.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target

# Save: ~/.config/systemd/user/inflect-tts.service
# Enable it:
# systemctl --user daemon-reload
# systemctl --user enable --now inflect-tts.service

# Inspect logs:
# journalctl --user -u inflect-tts -f
